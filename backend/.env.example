SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_BACKEND=postgres
# Supabase fallback still exists in code during migration, but GCP/Cloud SQL is the primary path.
DATABASE_URL=postgresql://clinic_user:clinic_password@127.0.0.1:5432/clinic_db
STORAGE_BACKEND=gcs
GCS_PATIENT_ATTACHMENTS_BUCKET=your-gcs-patient-attachments-bucket
AUTH_SECRET=replace-with-a-long-random-secret
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
INTERNAL_SCHEDULER_TOKEN=replace-with-a-long-random-internal-token
APP_ORIGIN=http://127.0.0.1:3000
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SUPER_ADMIN_IDENTIFIERS=
FOLLOW_UP_REMINDER_RUNNER_ENABLED=false
FOLLOW_UP_REMINDER_INTERVAL_SECONDS=300
