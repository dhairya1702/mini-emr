SUPER_ADMIN_IDENTIFIERS='dhairya911@gmail.com'
DATABASE_URL_SECRET_NAME='clinic-emr-database-url'
AUTH_SECRET_NAME='clinic-emr-auth-secret'

# Deploys prepare zero-traffic revisions by default. Set PROMOTE=1 only when
# intentionally moving the new revision to 100% production traffic.
PROMOTE='0'

# Required when production reminders are enabled through Cloud Scheduler or the
# in-process reminder runner.
PRODUCTION_REMINDERS_ENABLED='1'
INTERNAL_SCHEDULER_SECRET_NAME=''
FOLLOW_UP_REMINDER_RUNNER_ENABLED='false'
FOLLOW_UP_REMINDER_INTERVAL_SECONDS='300'

# Optional proactive patient messaging. The Meta template structure is
# documented in WHATSAPP_PHASE1_RUNBOOK.md.
WHATSAPP_FOLLOW_UP_TEMPLATE_NAME=''
WHATSAPP_FOLLOW_UP_TEMPLATE_LANGUAGE='en'

# Target overrides are blocked by default. Set only for an intentional emergency
# deploy to a non-standard target after manually verifying gcloud context.
BREAK_GLASS_DEPLOY_TARGET='0'
